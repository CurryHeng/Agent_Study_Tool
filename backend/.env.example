# EStudy 后端配置示例 —— 复制为 .env 后填写

# ── LLM（AI 出题 / AI 助手 必需）──
# DeepSeek API Key（必填，否则 /questions/generate 与 /agent/chat 会报错）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# 模型名：按你的 DeepSeek 账号实际模型填写（如 deepseek-chat / deepseek-v4-pro）
LLM_MODEL=deepseek-chat
# OpenAI-compatible API 地址（私有代理可覆盖）
LLM_BASE_URL=https://api.deepseek.com

# ── 视觉模型（图片解析，P1 再接入）──
# QWEN_API_KEY=
# EMBEDDING_MODEL=chroma-default

# ── 认证 ──
# 生产环境务必改成随机长字符串
JWT_SECRET=change-me-in-production
# ENCRYPTION_KEY=（可选，64 位 hex）

# ── 数据库 / 存储 ──
# DATABASE_URL=sqlite:///./data/quiz-app.db
# CHROMA_PATH=./data/chroma
# UPLOAD_DIR=./data/uploads
# MAX_FILE_SIZE=10485760
